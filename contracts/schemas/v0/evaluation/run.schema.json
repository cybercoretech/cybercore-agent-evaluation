{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/evaluation/run.schema.json",
  "title": "Execution Run",
  "description": "One actual execution attempt. Execution status, assessed outcome, and verification state are independent.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../common/record-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "record_type": {
          "const": "run"
        },
        "evaluation_ref": {
          "$ref": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/common/record-reference.schema.json"
        },
        "trial_ref": {
          "$ref": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/common/record-reference.schema.json"
        },
        "task_revision_ref": {
          "$ref": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/common/record-reference.schema.json"
        },
        "system_fingerprint_ref": {
          "$ref": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/common/record-reference.schema.json"
        },
        "attempt_number": {
          "type": "integer",
          "minimum": 1
        },
        "attempt_kind": {
          "type": "string",
          "enum": [
            "initial",
            "infrastructure_retry",
            "authorized_replay"
          ]
        },
        "attempt_reason": {
          "type": "string",
          "maxLength": 2048
        },
        "runner": {
          "type": "object",
          "properties": {
            "runner_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "runner_type": {
              "type": "string",
              "enum": [
                "local",
                "cloud",
                "self_hosted",
                "external"
              ]
            },
            "runner_version": {
              "type": "string",
              "maxLength": 128
            },
            "environment_ref": {
              "$ref": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/common/record-reference.schema.json"
            }
          },
          "required": [
            "runner_id",
            "runner_type"
          ],
          "additionalProperties": false
        },
        "execution_status": {
          "type": "string",
          "enum": [
            "created",
            "queued",
            "starting",
            "running",
            "finalizing",
            "finished",
            "errored",
            "timed_out",
            "cancelled"
          ]
        },
        "run_outcome": {
          "type": "string",
          "enum": [
            "pending",
            "pass",
            "fail",
            "inconclusive",
            "not_scored",
            "invalid"
          ]
        },
        "verification_state": {
          "type": "string",
          "enum": [
            "not_started",
            "in_progress",
            "verified_pass",
            "verified_fail",
            "mixed",
            "inconclusive",
            "unavailable"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "agent_report": {
          "type": "object",
          "properties": {
            "completion_claim": {
              "type": "string",
              "enum": [
                "completed",
                "partially_completed",
                "unable_to_complete",
                "no_claim"
              ]
            },
            "reported_at": {
              "type": "string",
              "format": "date-time"
            },
            "output_evidence_refs": {
              "type": "array",
              "items": {
                "$ref": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/common/evidence-reference.schema.json"
              }
            },
            "reported_usage": {
              "description": "Token and tool-call usage the agent reported about itself (cybercore-usage.json in its collected outputs). Self-reported and unverified; the workbench's own measurements stay in resource_usage. Cost is derived from these counts and the evaluation's declared prices.",
              "type": "object",
              "properties": {
                "source": {
                  "const": "agent_self_reported"
                },
                "report_status": {
                  "type": "string",
                  "enum": [
                    "reported",
                    "invalid"
                  ]
                },
                "invalid_reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "input_tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000000
                },
                "output_tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000000
                },
                "tool_calls": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000000
                },
                "models": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "properties": {
                      "model_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$"
                      },
                      "input_tokens": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000000000
                      },
                      "output_tokens": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000000000
                      }
                    },
                    "required": [
                      "model_id",
                      "input_tokens",
                      "output_tokens"
                    ],
                    "additionalProperties": false
                  }
                },
                "cost_microunits": {
                  "type": "integer",
                  "minimum": 0
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                "pricing_digest": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{64}$"
                },
                "unpriced_model_ids": {
                  "type": "array",
                  "maxItems": 32,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$"
                  }
                }
              },
              "required": [
                "source",
                "report_status"
              ],
              "dependentRequired": {
                "cost_microunits": [
                  "currency",
                  "pricing_digest"
                ]
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "report_status": {
                        "const": "reported"
                      }
                    },
                    "required": [
                      "report_status"
                    ],
                    "type": "object"
                  },
                  "then": {
                    "required": [
                      "input_tokens",
                      "output_tokens",
                      "models"
                    ],
                    "properties": {
                      "input_tokens": {},
                      "output_tokens": {},
                      "models": {}
                    },
                    "type": "object"
                  }
                },
                {
                  "if": {
                    "properties": {
                      "report_status": {
                        "const": "invalid"
                      }
                    },
                    "required": [
                      "report_status"
                    ],
                    "type": "object"
                  },
                  "then": {
                    "required": [
                      "invalid_reason"
                    ],
                    "properties": {
                      "invalid_reason": {}
                    },
                    "type": "object",
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "input_tokens"
                          ],
                          "properties": {
                            "input_tokens": {}
                          },
                          "type": "object"
                        },
                        {
                          "required": [
                            "output_tokens"
                          ],
                          "properties": {
                            "output_tokens": {}
                          },
                          "type": "object"
                        },
                        {
                          "required": [
                            "cost_microunits"
                          ],
                          "properties": {
                            "cost_microunits": {}
                          },
                          "type": "object"
                        }
                      ]
                    }
                  }
                }
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "completion_claim"
          ],
          "additionalProperties": false
        },
        "event_refs": {
          "type": "array",
          "items": {
            "$ref": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/common/record-reference.schema.json"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/common/evidence-reference.schema.json"
          }
        },
        "verification_refs": {
          "type": "array",
          "items": {
            "$ref": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/common/record-reference.schema.json"
          }
        },
        "resource_usage": {
          "type": "object",
          "properties": {
            "wall_time_ms": {
              "type": "integer",
              "minimum": 0
            },
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "tool_calls": {
              "type": "integer",
              "minimum": 0
            },
            "cost_microunits": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "error_summary": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "record_type",
        "evaluation_ref",
        "trial_ref",
        "task_revision_ref",
        "system_fingerprint_ref",
        "attempt_number",
        "attempt_kind",
        "runner",
        "execution_status",
        "run_outcome",
        "verification_state"
      ]
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "finished"
          }
        },
        "required": [
          "execution_status"
        ],
        "type": "object"
      },
      "then": {
        "required": [
          "started_at",
          "ended_at"
        ],
        "properties": {
          "started_at": {},
          "ended_at": {}
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "enum": [
              "finalizing",
              "running"
            ]
          }
        },
        "required": [
          "execution_status"
        ],
        "type": "object"
      },
      "then": {
        "required": [
          "started_at"
        ],
        "properties": {
          "started_at": {}
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "enum": [
              "errored",
              "timed_out",
              "cancelled"
            ]
          }
        },
        "required": [
          "execution_status"
        ],
        "type": "object"
      },
      "then": {
        "required": [
          "ended_at"
        ],
        "properties": {
          "ended_at": {}
        },
        "type": "object"
      }
    }
  ],
  "unevaluatedProperties": false
}
