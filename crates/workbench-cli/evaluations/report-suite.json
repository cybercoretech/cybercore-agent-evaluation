          "text": "done"
        }
      ]
    }
  ],
  "pricing": {
    "currency": "USD",
    "models": {
      "model-careful": {
        "input_per_million_tokens": 3.0,
        "output_per_million_tokens": 15.0
      },
      "model-sloppy": {
        "input_per_million_tokens": 0.8,
        "output_per_million_tokens": 4.0
      }
    }
  },
  "compare": [
    {
      "baseline": "SLOPPY",
      "treatment": "CAREFUL",
      "alpha": 0.05,
      "minimum_matched_tasks": 5
    }
  ]
}
