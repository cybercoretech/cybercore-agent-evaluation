{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/attribution/attribution-case.schema.json",
  "title": "Failure Attribution Case",
  "description": "Evidence-linked investigation with competing hypotheses, a versioned causal/diagnostic graph, and a strict confirmation basis.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/common/record-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "record_type": {
          "const": "attribution_case"
        },
        "failure_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/common/record-reference.schema.json"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "uninvestigated",
            "investigating",
            "provisional",
            "confirmed",
            "refuted",
            "unresolved"
          ]
        },
        "decisive_event_refs": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/common/record-reference.schema.json"
          }
        },
        "gap_node_refs": {
          "type": "object",
          "properties": {
            "detection": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              }
            },
            "containment": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              }
            },
            "reporting": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              }
            }
          },
          "required": [
            "detection",
            "containment",
            "reporting"
          ],
          "additionalProperties": false
        },
        "hypotheses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "hypothesis_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "category": {
                "type": "string",
                "enum": [
                  "model_behavior",
                  "task_instruction",
                  "system_policy",
                  "skill_asset",
                  "context_management",
                  "memory_retrieval",
                  "planning_orchestration",
                  "tool_selection",
                  "tool_contract_adapter",
                  "tool_execution",
                  "permissions_authorization",
                  "environment",
                  "external_dependency",
                  "benchmark_ground_truth",
                  "grader_verifier",
                  "detection",
                  "containment",
                  "reporting",
                  "multi_agent_interaction",
                  "unknown"
                ]
              },
              "claim": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "status": {
                "type": "string",
                "enum": [
                  "active",
                  "supported",
                  "refuted",
                  "inconclusive"
                ]
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "supporting_evidence": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "$ref": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/common/evidence-reference.schema.json"
                }
              },
              "contradicting_evidence": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "$ref": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/common/evidence-reference.schema.json"
                }
              },
              "alternative_hypothesis_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                }
              },
              "next_test": {
                "type": "string",
                "maxLength": 2048
              }
            },
            "required": [
              "hypothesis_id",
              "category",
              "claim",
              "status",
              "confidence",
              "supporting_evidence",
              "contradicting_evidence"
            ],
            "additionalProperties": false
          }
        },
        "causal_graph": {
          "$ref": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/attribution/causal-graph.schema.json"
        },
        "confirmed_hypothesis_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        },
        "confirmation": {
          "type": "object",
          "properties": {
            "basis": {
              "type": "string",
              "enum": [
                "direct_mechanistic_evidence",
                "controlled_replicated_intervention",
                "combined"
              ]
            },
            "mechanism_description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "mechanism_evidence_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/common/evidence-reference.schema.json"
              }
            },
            "intervention_ref": {
              "$ref": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/common/record-reference.schema.json"
            },
            "replicated_trial_count": {
              "type": "integer",
              "minimum": 2
            },
            "control_treatment_summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/common/evidence-reference.schema.json"
              }
            },
            "reviewed_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "basis",
            "evidence_refs",
            "reviewed_at"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "basis": {
                    "enum": [
                      "direct_mechanistic_evidence",
                      "combined"
                    ]
                  }
                },
                "required": [
                  "basis"
                ],
                "type": "object"
              },
              "then": {
                "required": [
                  "mechanism_description",
                  "mechanism_evidence_refs"
                ],
                "properties": {
                  "mechanism_description": {},
                  "mechanism_evidence_refs": {}
                },
                "type": "object"
              }
            },
            {
              "if": {
                "properties": {
                  "basis": {
                    "enum": [
                      "controlled_replicated_intervention",
                      "combined"
                    ]
                  }
                },
                "required": [
                  "basis"
                ],
                "type": "object"
              },
              "then": {
                "required": [
                  "intervention_ref",
                  "replicated_trial_count",
                  "control_treatment_summary"
                ],
                "properties": {
                  "intervention_ref": {},
                  "replicated_trial_count": {},
                  "control_treatment_summary": {}
                },
                "type": "object"
              }
            }
          ],
          "additionalProperties": false
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "next_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      },
      "required": [
        "record_type",
        "failure_refs",
        "status",
        "gap_node_refs",
        "hypotheses",
        "causal_graph"
      ]
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "confirmed"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "then": {
        "required": [
          "confirmed_hypothesis_ids",
          "confirmation"
        ],
        "properties": {
          "confirmed_hypothesis_ids": {},
          "confirmation": {}
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "uninvestigated",
              "investigating",
              "provisional",
              "refuted",
              "unresolved"
            ]
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "then": {
        "not": {
          "required": [
            "confirmation"
          ],
          "type": "object",
          "properties": {
            "confirmation": {}
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
