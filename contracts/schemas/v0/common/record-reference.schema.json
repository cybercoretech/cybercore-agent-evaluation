{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/common/record-reference.schema.json",
  "title": "Record Reference",
  "description": "Stable reference to another Workbench record. Referential integrity and authorization are enforced by application services.",
  "type": "object",
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "record_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    }
  },
  "required": [
    "record_id",
    "record_type"
  ],
  "additionalProperties": false
}
