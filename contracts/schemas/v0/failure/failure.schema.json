{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/failure/failure.schema.json",
  "title": "Failure Record",
  "description": "Observed unmet objective, prohibited outcome, or requirement violation. Failure verification is distinct from the agent completion claim.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/common/record-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "record_type": {
          "const": "failure"
        },
        "run_ref": {
          "$ref": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/common/record-reference.schema.json"
        },
        "failure_class": {
          "type": "string",
          "enum": [
            "objective_not_met",
            "prohibited_outcome",
            "requirement_violation",
            "verification_failure",
            "data_integrity_failure",
            "uncontrolled_side_effect",
            "other"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "violated_requirement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "decisive_event_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/common/record-reference.schema.json"
          }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/common/evidence-reference.schema.json"
          }
        },
        "verification_state": {
          "type": "string",
          "enum": [
            "unverified",
            "verified",
            "disputed"
          ]
        },
        "verification_result_ref": {
          "$ref": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/common/record-reference.schema.json"
        },
        "verification_limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "gap_node_refs": {
          "type": "object",
          "properties": {
            "detection": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              }
            },
            "containment": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              }
            },
            "reporting": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              }
            }
          },
          "required": [
            "detection",
            "containment",
            "reporting"
          ],
          "additionalProperties": false
        },
        "recovery_summary": {
          "type": "string",
          "maxLength": 2048
        },
        "final_state_summary": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "required": [
        "record_type",
        "run_ref",
        "failure_class",
        "observed_at",
        "summary",
        "violated_requirement",
        "decisive_event_refs",
        "evidence_refs",
        "verification_state",
        "gap_node_refs"
      ]
    },
    {
      "if": {
        "properties": {
          "verification_state": {
            "const": "verified"
          }
        },
        "required": [
          "verification_state"
        ],
        "type": "object"
      },
      "then": {
        "required": [
          "verification_result_ref"
        ],
        "properties": {
          "verification_result_ref": {}
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "verification_state": {
            "enum": [
              "unverified",
              "disputed"
            ]
          }
        },
        "required": [
          "verification_state"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "verification_limitations": {
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "verification_limitations"
        ],
        "type": "object"
      }
    }
  ],
  "unevaluatedProperties": false
}
