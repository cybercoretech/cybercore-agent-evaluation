{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/passport/capability-passport.schema.json",
  "title": "Agent Capability Passport",
  "description": "Evidence-bounded summary of one exact evaluated configuration for a declared workload and autonomy scope. Not a universal certification.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/common/record-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "record_type": {
          "const": "capability_passport"
        },
        "passport_status": {
          "type": "string",
          "enum": [
            "draft",
            "active",
            "expired",
            "revoked",
            "review_required"
          ]
        },
        "system_fingerprint_ref": {
          "$ref": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/common/record-reference.schema.json"
        },
        "readiness_decision_ref": {
          "$ref": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/common/record-reference.schema.json"
        },
        "scope": {
          "type": "object",
          "properties": {
            "workload_families": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "task_families": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "operating_conditions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "autonomy_level": {
              "type": "string",
              "enum": [
                "assisted",
                "supervised",
                "bounded_autonomous",
                "high_autonomy"
              ]
            },
            "permitted_effects": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "excluded_effects": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            }
          },
          "required": [
            "workload_families",
            "operating_conditions",
            "autonomy_level",
            "permitted_effects",
            "excluded_effects"
          ],
          "additionalProperties": false
        },
        "evaluation_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/common/record-reference.schema.json"
          }
        },
        "attribution_refs": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/common/record-reference.schema.json"
          }
        },
        "trial_summary": {
          "type": "object",
          "properties": {
            "planned_trials": {
              "type": "integer",
              "minimum": 1
            },
            "eligible_trials": {
              "type": "integer",
              "minimum": 0
            },
            "excluded_trials": {
              "type": "integer",
              "minimum": 0
            },
            "resolved_trials": {
              "type": "integer",
              "minimum": 0
            },
            "pass_trials": {
              "type": "integer",
              "minimum": 0
            },
            "fail_trials": {
              "type": "integer",
              "minimum": 0
            },
            "mixed_trials": {
              "type": "integer",
              "minimum": 0
            },
            "inconclusive_trials": {
              "type": "integer",
              "minimum": 0
            },
            "run_attempts": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "planned_trials",
            "eligible_trials",
            "excluded_trials",
            "resolved_trials",
            "pass_trials",
            "fail_trials",
            "mixed_trials",
            "inconclusive_trials",
            "run_attempts"
          ],
          "additionalProperties": false
        },
        "capability_dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "dimension_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "eligible_trials": {
                "type": "integer",
                "minimum": 0
              },
              "pass_trials": {
                "type": "integer",
                "minimum": 0
              },
              "fail_trials": {
                "type": "integer",
                "minimum": 0
              },
              "inconclusive_trials": {
                "type": "integer",
                "minimum": 0
              },
              "uncertainty_summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/common/evidence-reference.schema.json"
                }
              }
            },
            "required": [
              "dimension_id",
              "description",
              "eligible_trials",
              "pass_trials",
              "fail_trials",
              "inconclusive_trials",
              "uncertainty_summary",
              "evidence_refs"
            ],
            "additionalProperties": false
          }
        },
        "known_failure_refs": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "https://raw.githubusercontent.com/cybercoretech/cybercore-agent-evaluation/main/contracts/schemas/v0/common/record-reference.schema.json"
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "permitted_use_constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "review_by": {
          "type": "string",
          "format": "date-time"
        },
        "revocation_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "record_type",
        "passport_status",
        "system_fingerprint_ref",
        "readiness_decision_ref",
        "scope",
        "evaluation_refs",
        "trial_summary",
        "capability_dimensions",
        "limitations",
        "permitted_use_constraints"
      ]
    },
    {
      "if": {
        "properties": {
          "passport_status": {
            "const": "active"
          }
        },
        "required": [
          "passport_status"
        ],
        "type": "object"
      },
      "then": {
        "required": [
          "issued_at",
          "expires_at",
          "review_by"
        ],
        "properties": {
          "issued_at": {},
          "expires_at": {},
          "review_by": {}
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "passport_status": {
            "const": "revoked"
          }
        },
        "required": [
          "passport_status"
        ],
        "type": "object"
      },
      "then": {
        "required": [
          "revocation_reason"
        ],
        "properties": {
          "revocation_reason": {}
        },
        "type": "object"
      }
    }
  ],
  "unevaluatedProperties": false
}
